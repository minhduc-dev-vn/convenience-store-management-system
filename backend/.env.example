NODE_ENV=development
PORT=3000

# HTTP security (comma-separated exact browser origins; leave empty for non-browser/same-origin clients)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false

# SQL Server driver: tedious (SQL authentication/TCP) or msnodesqlv8 (Windows trusted connection)
DB_DRIVER=tedious
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_PORT=
DB_NAME=ConvenienceStore
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000

# Authentication
# Development placeholder only. Replace with a random secret before any shared/staging/production use.
JWT_SECRET=replace-with-at-least-32-random-bytes-before-use
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
