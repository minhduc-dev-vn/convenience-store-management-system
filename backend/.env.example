NODE_ENV=development
PORT=3000

# SQL Server driver: tedious (SQL authentication/TCP) or msnodesqlv8 (Windows trusted connection)
DB_DRIVER=tedious
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_PORT=
DB_NAME=ConvenienceStore
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
